army_units = Dictionary[StringName, float]({&"swordsman": 1.0, &"spearman": 1.0, &"archer": 1.0, &"elite_swordsman": 2.0, &"elite_spearman": 2.0, &"elite_archer": 2.0, &"shield_veteran": 1.0, &"crossbow_pro": 1.0, &"light_cavalry": 1.0})
