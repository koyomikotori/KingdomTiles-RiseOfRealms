grid = Vector2i(1, 4)
personality = 1
military_strength = 200
surplus = Array[StringName]([&"wood"])
deficit = Array[StringName]([&"food"])
start_relation = -10
base_relation = -15
friends = Array[StringName]([&"fisher_bay"])
army_units = Dictionary[StringName, float]({&"elite_swordsman": 1.0, &"elite_spearman": 1.0, &"royal_swordguard": 2.0, &"royal_pikeguard": 2.0, &"marksman_archer": 2.0, &"crossbow_elite": 1.0, &"lancer_cavalry": 1.0, &"elite_musketeer": 1.0, &"light_artillery": 1.0, &"shield_guard": 1.0})
