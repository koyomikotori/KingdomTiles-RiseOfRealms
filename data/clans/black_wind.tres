[gd_resource type="Resource" script_class="ClanData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/diplomacy/clan_data.gd" id="1_clan"]

[resource]
script = ExtResource("1_clan")
clan_id = &"black_wind"
display_name = "Hắc Phong Trại"
