[gd_resource type="Resource" script_class="BuildingData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/buildings/building_data.gd" id="1_building"]

[resource]
script = ExtResource("1_building")
building_id = &"lumber_mill"
display_name = "Xưởng gỗ"
description = "Đốn gỗ, từ cấp 2 có thêm gỗ cứng. Mỗi ô rừng trống kề bên +2 gỗ; trên ô ◆ sản lượng gấp đôi."
cost = Dictionary[StringName, int]({&"wood": 6, &"stone": 4})
allowed_terrains = Array[StringName]([&"forest"])
max_count = 3
field_resource = &"wood"
color = Color(0.5, 0.35, 0.15, 1)
upkeep = Dictionary[StringName, int]({&"food": 1})
level_yields = Array[Dictionary]([{&"wood": 5}, {&"wood": 8, &"hardwood": 1}, {&"wood": 10, &"hardwood": 2}, {&"wood": 12, &"hardwood": 3}, {&"wood": 14, &"hardwood": 4}, {&"wood": 17, &"hardwood": 5}])
