[gd_resource type="Resource" script_class="BuildingData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/buildings/building_data.gd" id="1_building"]

[resource]
script = ExtResource("1_building")
building_id = &"barracks"
display_name = "Doanh trại"
description = "Tuyển và bổ sung quân. Mỗi doanh trại thêm 4 chỗ cho đơn vị; cấp càng cao mở bậc lính càng mạnh và hồi quân càng nhanh."
cost = Dictionary[StringName, int]({&"wood": 6, &"stone": 2})
allowed_terrains = Array[StringName]([&"grass"])
max_count = 3
color = Color(0.45, 0.3, 0.2, 1)
squad_capacity = 4
enables_replenishment = true
category = 1
build_turns = 2
upgrade_levels = 6
replenish_per_level = 0.005
