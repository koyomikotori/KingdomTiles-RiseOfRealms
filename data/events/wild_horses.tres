[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/events/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/events/event_choice_data.gd" id="2_choice"]
[ext_resource type="Script" path="res://scripts/events/event_outcome_data.gd" id="3_outcome"]

[sub_resource type="Resource" id="outcome_0_0"]
script = ExtResource("3_outcome")
text = "Dân làng quăng thòng lọng, lùa ngựa về chuồng."
random_resources = Dictionary[StringName, Dictionary]({
&"horses": {
10: 0.5,
15: 0.3,
20: 0.2
}
})

[sub_resource type="Resource" id="choice_0"]
script = ExtResource("2_choice")
text = "Đổi lương với dân làng"
hint = "Dân làng quen việc, chắc chắn bắt được vài con."
cost = Dictionary[StringName, int]({&"food": 30})
outcomes = Array[ExtResource("3_outcome")]([SubResource("outcome_0_0")])

[sub_resource type="Resource" id="outcome_1_0"]
script = ExtResource("3_outcome")
text = "Lính chia nhau đuổi theo bầy ngựa qua mấy ngọn đồi."
random_resources = Dictionary[StringName, Dictionary]({
&"horses": {
0: 0.5,
10: 0.3,
15: 0.2
}
})

[sub_resource type="Resource" id="choice_1"]
script = ExtResource("2_choice")
text = "Cho lính tự đi bắt"
hint = "Không tốn lương, nhưng lính không quen việc, dễ về tay trắng."
outcomes = Array[ExtResource("3_outcome")]([SubResource("outcome_1_0")])

[sub_resource type="Resource" id="outcome_2_0"]
script = ExtResource("3_outcome")
text = "Bầy ngựa phi qua đồng cỏ rồi khuất bóng."

[sub_resource type="Resource" id="choice_2"]
script = ExtResource("2_choice")
text = "Để chúng đi"
hint = "Không tốn gì."
outcomes = Array[ExtResource("3_outcome")]([SubResource("outcome_2_0")])

[resource]
script = ExtResource("1_event")
event_id = &"wild_horses"
title = "Bầy ngựa hoang"
text = "Một bầy ngựa hoang kéo về đồng cỏ gần biên giới. Dân làng quanh đó quen bắt ngựa, nhưng đòi lương thực mới chịu giúp."
category = 0
weight = 2.0
cooldown = 8
min_terrain = Dictionary[StringName, int]({&"grass": 3})
choices = Array[ExtResource("2_choice")]([SubResource("choice_0"), SubResource("choice_1"), SubResource("choice_2")])
