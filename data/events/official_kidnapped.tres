[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/events/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/events/event_choice_data.gd" id="2_choice"]
[ext_resource type="Script" path="res://scripts/events/event_outcome_data.gd" id="3_outcome"]

[sub_resource type="Resource" id="outcome_0_0"]
script = ExtResource("3_outcome")
text = "Quân ta lần theo dấu vết, bao vây sào huyệt đạo tặc."
battle = &"rescue"
weight = 1.0

[sub_resource type="Resource" id="choice_0"]
script = ExtResource("2_choice")
text = "Cứu viện"
min_squads_home = 1
hint = "3–5 đơn vị ngẫu nhiên (và tổng tướng nếu có) đánh vào sào huyệt. Thắng có quà tạ ơn, thua thì quan chức bị giết."
outcomes = Array[ExtResource("3_outcome")]([SubResource("outcome_0_0")])

[sub_resource type="Resource" id="outcome_1_0"]
script = ExtResource("3_outcome")
text = "Đạo tặc nhận tiền và thả người như đã hứa."
weight = 1.0

[sub_resource type="Resource" id="choice_1"]
script = ExtResource("2_choice")
text = "Chuộc người"
cost = Dictionary[StringName, int]({&"food": 100, &"ore": 20})
hint = "Trả tiền chuộc, quan chức trở về an toàn."
outcomes = Array[ExtResource("3_outcome")]([SubResource("outcome_1_0")])

[sub_resource type="Resource" id="outcome_2_0"]
script = ExtResource("3_outcome")
text = "Quan chức bị giết. Tin lan khắp nơi rằng vương quốc bỏ rơi người của mình."
relation_all = -8
weight = 1.0

[sub_resource type="Resource" id="choice_2"]
script = ExtResource("2_choice")
text = "Bỏ mặc"
hint = "Các gia tộc sẽ coi thường vương quốc."
outcomes = Array[ExtResource("3_outcome")]([SubResource("outcome_2_0")])

[resource]
script = ExtResource("1_event")
event_id = &"official_kidnapped"
title = "Đạo tặc bắt giữ quan chức"
text = "Đạo tặc phục kích đoàn tuần thú, bắt sống một quan huyện của vương quốc và đòi tiền chuộc."
category = 3
weight = 1.5
cooldown = 12
min_turn = 5
needs_bandit_activity = true
min_squads = 1
choices = Array[ExtResource("2_choice")]([SubResource("choice_0"), SubResource("choice_1"), SubResource("choice_2")])
