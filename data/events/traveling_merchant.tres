text = "Hàng giả! Bọn chúng đã cao chạy xa bay."

[sub_resource type="Resource" id="choice_0"]
script = ExtResource("2_choice")
text = "Đổi 20 lương thực"
hint = "Có thể đổi được hàng quý, cũng có thể lỗ hoặc bị lừa."
cost = Dictionary[StringName, int]({&"food": 20})
outcomes = Array[ExtResource("3_outcome")]([SubResource("outcome_0_0"), SubResource("outcome_0_1"), SubResource("outcome_0_2"), SubResource("outcome_0_3"), SubResource("outcome_0_4"), SubResource("outcome_0_5"), SubResource("outcome_0_6")])

