[resource]
script = ExtResource("1_event")
event_id = &"traveling_merchant"
title = "Thương nhân lạ"
text = "Một đoàn thương nhân từ phương xa ghé qua, sẵn lòng đổi hàng lạ lấy lương thực, gỗ hay đá."
category = 0
weight = 2.0
cooldown = 6
choices = Array[ExtResource("2_choice")]([SubResource("choice_0"), SubResource("choice_1"), SubResource("choice_2"), SubResource("choice_3")])
